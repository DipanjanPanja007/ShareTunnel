# ── ShareTunnel Server Environment Variables ──────────────────────────────────
# Copy this file to .env for local development.
# In production, set these as environment variables in your hosting platform.

# Port the signaling server listens on
PORT=3001

# Allowed CORS origins (comma-separated, no spaces)
# Local development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Production example:
# ALLOWED_ORIGINS=https://your-sharebridge-app.vercel.app
